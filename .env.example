# === Base de données PostgreSQL ===
POSTGRES_DB=sigmagestion
POSTGRES_USER=sigma
POSTGRES_PASSWORD=sigma
POSTGRES_PORT=5432

# === Redis ===
REDIS_PORT=6379

# === Django (utilisé à partir de l'étape 0.3) ===
DJANGO_SECRET_KEY=change-moi-en-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://sigma:sigma@db:5432/sigmagestion
REDIS_URL=redis://redis:6379/0

# === Celery ===
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === Notifications Web Push (VAPID) ===
# Générer avec : docker compose run --rm web vapid --gen && docker compose run --rm web vapid --applicationServerKey
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@sigmagestion.local
