# Variables de production — copier en .env sur le serveur, NE PAS versionner.

# Django
DJANGO_SECRET_KEY=remplacer-par-une-cle-longue-et-unique
DJANGO_ALLOWED_HOSTS=sigmagestion.cm,www.sigmagestion.cm
DJANGO_CSRF_TRUSTED_ORIGINS=https://sigmagestion.cm,https://www.sigmagestion.cm
CORS_ALLOWED_ORIGINS=https://sigmagestion.cm,https://www.sigmagestion.cm

# Base de données
POSTGRES_DB=sigmagestion
POSTGRES_USER=sigma
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-fort

# Notifications push (VAPID) — la clé privée est montée via private_key.pem
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@sigmagestion.cm

# Supervision des erreurs (optionnel)
SENTRY_DSN=
SENTRY_ENV=production
